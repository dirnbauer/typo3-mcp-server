includes:
    - vendor/phpat/phpat/extension.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon
    # TYPO3 v14 PHPStan rules (saschaegerer/phpstan-typo3) — TCA, FormEngine,
    # DataHandler, Extbase repository typing, deprecated calls.
    - vendor/saschaegerer/phpstan-typo3/extension.neon
    # Flag use of @deprecated APIs (TYPO3 v14 cleanups).
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon

parameters:
    # Portfolio baseline: level 8 everywhere, no baseline file, no ignores.
    level: 8
    # All own PHP: extension code, its configuration, every test suite
    # (unit, architecture, functional incl. fixture extensions, LLM), the
    # build scripts and the tool configurations in the repository root.
    paths:
        - Classes
        - Configuration
        - Tests
        - Build
        - .php-cs-fixer.dist.php
        - fractor.php
        - rector.php
    excludePaths:
        analyse:
            # Declaration-only stub, scanned below rather than analysed.
            - Build/PHPStan
        analyseAndScan:
            - Build/node_modules (?)
    scanFiles:
        # The optional paywall package cannot be installed in this dependency
        # tree; keep its conditional adapter type-checked against the exact
        # API surface we consume.
        - Build/PHPStan/typo3-x402-paywall.php
    treatPhpDocTypesAsCertain: false
